NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
AGENT_SERVICE_URL=http://127.0.0.1:8000
INTERNAL_API_KEY=replace_with_a_long_random_shared_secret

# Deploy `web` twice: once as the public/organization app and once as the
# OutLawed operator portal. Both deployments use the same Supabase project.
PORTAL_MODE=public
PUBLIC_APP_URL=http://localhost:3000
ADMIN_PORTAL_URL=http://localhost:3001
